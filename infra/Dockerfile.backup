# Container sao lưu: chỉ chứa thứ cần để dump, mã hoá và đẩy đi — không có mã ứng dụng, không có
# quyền ghi vào CSDL ngoài `pg_dump`, và KHÔNG bao giờ thấy `POOL_MASTER_KEY` (§20.5, §20.6).
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PGHOST=postgres \
    PGDATABASE=visynth

# `postgresql-client` để `pg_dump -Fc`; `age` để mã hoá bằng khoá công khai; `rclone` để đẩy sang
# nhà cung cấp khác; `ca-certificates` cho TLS; `curl` để ping dead man's switch.
RUN apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client age rclone ca-certificates curl tini \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Chỉ cần CLI (để chạy `db migrate` và `ops reap` sau khi khôi phục), không cần FastAPI.
COPY pyproject.toml README.md ./
COPY apps/worker ./apps/worker
COPY apps/api/visynth_api ./apps/api/visynth_api
COPY apps/api/alembic ./apps/api/alembic
COPY apps/api/alembic.ini ./apps/api/alembic.ini
COPY docs/db ./docs/db
COPY infra ./infra
RUN pip install --no-cache-dir /app

RUN useradd --system --uid 10002 --home /backup --shell /usr/sbin/nologin backup \
 && mkdir -p /backup \
 && chown -R backup:backup /backup
USER 10002:10002

ENTRYPOINT ["/usr/bin/tini", "--"]
# Vòng lặp hằng ngày: ngủ tới giờ hẹn rồi chạy `backup.sh`; giờ chọn theo `BACKUP_HOUR` (UTC).
CMD ["/app/infra/backup-loop.sh"]
