# =====================================================================================
# ViSynth trên VPS — MẪU biến môi trường. Sao chép thành `infra/.env` rồi điền.
#
#   cp infra/.env.example infra/.env && chmod 600 infra/.env
#
# TUYỆT ĐỐI KHÔNG đưa khoá API nhà cung cấp (Gemini/NVIDIA) vào tệp này: chúng được nhập một lần
# qua Admin > Pool (mục "Khai báo nhanh") rồi nằm trong CSDL dưới dạng mã hoá (`secret_enc`).
# `POOL_MASTER_KEY` cũng KHÔNG nằm ở đây — nó là Docker secret (xem `infra/README.md`).
# =====================================================================================

# ---- Bắt buộc ------------------------------------------------------------------------
# Tên miền đã trỏ A/AAAA về IP của VPS (Caddy tự xin chứng chỉ TLS).
VISYNTH_DOMAIN=visynth.example.com
# Email cho Let's Encrypt (nhận thông báo hết hạn chứng chỉ).
ACME_EMAIL=ban@example.com
# Mật khẩu PostgreSQL: sinh bằng `openssl rand -base64 32`.
POSTGRES_PASSWORD=
# Bí mật ký cookie phiên: sinh bằng `openssl rand -base64 48`.
VISYNTH_SESSION_SECRET=
# Khoá CÔNG KHAI của age để mã hoá bản sao lưu (khoá riêng cất ở máy khác, KHÔNG ở đây).
#   Sinh một lần ở máy của bạn:  age-keygen -o visynth-backup-key.txt
#   rồi dán dòng "Public key: age1..." vào đây.
AGE_PUBLIC_KEY=
# Đích đẩy bản sao lưu: NHÀ CUNG CẤP KHÁC, VÙNG KHÁC với VPS (§20.6). Ví dụ `r2:visynth-backup`.
RCLONE_REMOTE=

# ---- Nên đặt ------------------------------------------------------------------------
# Số bản worker (mặc định 2). Số bản bị chặn bởi hạn mức nhà cung cấp, không bởi CPU (§20.2).
WORKER_REPLICAS=2
# URL "dead man's switch" (healthchecks.io…) — KHÔNG thấy tín hiệu trong 26 giờ thì báo động (§20.7).
BACKUP_HEALTHCHECK_URL=
# Giờ sao lưu theo UTC (3 = 10 giờ sáng Hà Nội).
BACKUP_HOUR=3
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# Email đầu tiên được tự động gán vai trò admin (tài khoản này không cần mã mời).
VISYNTH_ADMIN_EMAIL=
# Đăng ký không cần mã mời (chỉ nên bật khi chạy thử; cổng A trở lên để trống).
VISYNTH_OPEN_SIGNUP=false
# Bắt buộc để ghim phiên bản image khi nâng cấp (§20.7).
VISYNTH_TAG=
