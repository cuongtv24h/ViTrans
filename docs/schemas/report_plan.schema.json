{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visynth.example/schemas/report_plan.schema.json",
  "title": "ReportPlan",
  "description": "Đầu ra của prompt P3_report_planner: dàn ý báo cáo, phân bổ đơn vị tri thức vào từng mục, danh sách gộp trùng và lược bỏ có chủ đích. Các đơn vị 'minor' KHÔNG cần liệt kê (hệ thống tự coi là lược bỏ ở mức 3-4).",
  "type": "object",
  "properties": {
    "report_title_vi": { "type": "string", "maxLength": 160 },
    "report_subtitle_vi": { "type": ["string", "null"], "maxLength": 200 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/sectionId" },
          "kind": { "type": "string", "enum": ["summary", "body"] },
          "title_vi": { "type": "string", "maxLength": 140 },
          "purpose_vi": { "type": "string", "maxLength": 300 },
          "unit_ids": { "type": "array", "maxItems": 200, "items": { "$ref": "common.schema.json#/$defs/unitId" } },
          "target_words": { "type": "integer", "minimum": 40, "maximum": 3000 },
          "format_hint": { "type": "string", "enum": ["narrative", "bullets", "table", "mixed"] }
        },
        "required": ["id", "kind", "title_vi", "purpose_vi", "unit_ids", "target_words", "format_hint"],
        "additionalProperties": false
      }
    },
    "merged_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "keep_unit_id": { "$ref": "common.schema.json#/$defs/unitId" },
          "merged_unit_ids": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "common.schema.json#/$defs/unitId" } },
          "reason_vi": { "type": "string", "maxLength": 200 }
        },
        "required": ["keep_unit_id", "merged_unit_ids", "reason_vi"],
        "additionalProperties": false
      }
    },
    "omitted": {
      "type": "array",
      "description": "Chỉ liệt kê đơn vị supporting bị lược bỏ có chủ đích (core không được lược bỏ; minor do hệ thống xử lý).",
      "items": {
        "type": "object",
        "properties": {
          "unit_id": { "$ref": "common.schema.json#/$defs/unitId" },
          "reason": { "type": "string", "enum": ["redundant", "off_topic", "level_policy"] }
        },
        "required": ["unit_id", "reason"],
        "additionalProperties": false
      }
    },
    "include_facts_table": { "type": "boolean" },
    "facts_unit_ids": { "type": "array", "maxItems": 300, "items": { "$ref": "common.schema.json#/$defs/unitId" } },
    "include_glossary_appendix": { "type": "boolean" }
  },
  "required": ["report_title_vi", "report_subtitle_vi", "sections", "merged_groups", "omitted", "include_facts_table", "facts_unit_ids", "include_glossary_appendix"],
  "additionalProperties": false
}
