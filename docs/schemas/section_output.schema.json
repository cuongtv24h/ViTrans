{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visynth.example/schemas/section_output.schema.json",
  "title": "SectionOutput",
  "description": "Đầu ra của prompt P4_section_writer cho MỘT mục báo cáo. Model chỉ trả danh sách khối; hệ thống tự cấp blockId (S03.b01, S03.b02...) theo thứ tự.",
  "type": "object",
  "properties": {
    "section_id": { "$ref": "common.schema.json#/$defs/sectionId" },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": { "$ref": "common.schema.json#/$defs/block" }
    },
    "flags": {
      "type": "array",
      "maxItems": 20,
      "description": "Đơn vị được giao nhưng model không thể diễn đạt trung thực (bằng chứng mơ hồ/mâu thuẫn) hoặc cần người xem lại.",
      "items": {
        "type": "object",
        "properties": {
          "unit_id": { "$ref": "common.schema.json#/$defs/unitId" },
          "reason_vi": { "type": "string", "maxLength": 240 }
        },
        "required": ["unit_id", "reason_vi"],
        "additionalProperties": false
      }
    }
  },
  "required": ["section_id", "blocks", "flags"],
  "additionalProperties": false
}
