# Nơi DUY NHẤT chứa khoá API thật. Chép tệp này thành `.env` (đã bị .gitignore) rồi dán khoá vào.
#   cp .env.example .env
# Không dán khoá vào chat, vào pool_config.json, vào commit hay ảnh chụp màn hình.
# `visynth` tự đọc `.env` khi cần (không cần `export`).

# Gemini trả phí theo dùng — model chính cho tiếng Việt (khoá chính).
GEMINI_API_KEY=

# Khoá dự phòng thứ nhất: NVIDIA API Catalog (bản thử nghiệm, chỉ dùng cho tài liệu không nhạy cảm).
NVIDIA_API_KEY=

# Khoá dự phòng thứ hai (tuỳ chọn, chỉ một khoá): nhà cung cấp theo chuẩn OpenAI Chat Completions.
RESERVE_API_KEY=

# Bộ bóc tách trong sandbox. Chỉ cần đặt khi CHẠY NGOÀI compose (compose đã đặt sẵn
# `VISYNTH_PARSER_URL=http://parser:8080`). Để trống = bóc tách ngay trong tiến trình API (máy dev).
# Khi trỏ tới dịch vụ thật, nên chạy nó bằng `python -m visynth.cli parse-server`.
VISYNTH_PARSER_URL=
